# ScienceBoard harness (research/scienceboard) — host environment.
# Copy to a private location (never commit a filled-in copy) and export the
# variables in the shell that runs preflight/orchestrate. Paths are examples.

# Private storage root for every raw ScienceBoard input and output. Absolute,
# outside this repository, outside any Git work tree and outside research/evidence.
CUA_PRIVATE_ROOT=/absolute/path/outside/the/repository/private

# Pinned ScienceBoard checkout (commit c8d5010bdba32afc5dfb16472873bed148c39a45, clean).
SCIENCEBOARD_ROOT=/absolute/path/to/ScienceBoard

# VMware: the provisioned .vmx; VMRUN_PATH only if vmrun is not on PATH.
VM_PATH=/absolute/path/to/ScienceBoard/Ubuntu.vmx
VMRUN_PATH=

# Private certificates and driver, all under CUA_PRIVATE_ROOT.
SCIENCEBOARD_VM_PROVENANCE=/absolute/path/outside/the/repository/private/scienceboard/vm-provenance.json
SCIENCEBOARD_CALIBRATION_EVIDENCE=/absolute/path/outside/the/repository/private/scienceboard/calibration/evidence.json
SCIENCEBOARD_CALIBRATION_CERT=/absolute/path/outside/the/repository/private/scienceboard/calibration/certificate.json
SCIENCEBOARD_DRIVER_CONFIG=/absolute/path/outside/the/repository/private/scienceboard/driver.json

# Model access for the AIO/SeeAct actors (the endpoint is fixed by the protocol).
SCIENCEBOARD_MODEL=gpt-5.5
OPENAI_API_KEY=
SCIENCEBOARD_REASONING_EFFORT=medium

# Optional guest recorder directories (must stay under /home/user).
SCIENCEBOARD_GUEST_DATA_ROOT=/home/user/.local/share/computer-use-agent/sessions
SCIENCEBOARD_GUEST_CONTROL_DIR=/home/user/.local/share/computer-use-agent/control

# Set only while the named human cell is being performed by the operator.
SCIENCEBOARD_SELF_CONSENT_SESSION_ID=

# Human cells and detector hand-off: the private human-research determination
# record (under CUA_PRIVATE_ROOT; its SHA-256 must match the formal-study config).
CUA_HUMAN_RESEARCH_DETERMINATION_RECORD=
