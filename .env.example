# ComputerUseAgent environment variables (product only).
#
# The Python package and the extension tooling read the process environment
# directly; nothing loads this file automatically. Copy it to .env only if your
# own launcher loads dotenv files, and never commit the populated copy (.env is
# git-ignored). Research-harness variables (VMs, providers, ScienceBoard) are
# documented beside each harness under research/.

# --- Private data -----------------------------------------------------------
# Root directory for private, non-redistributable data (raw traces, formal-study
# outputs). It must resolve outside the repository checkout and outside
# research/evidence; tools refuse to write private data anywhere else.
CUA_PRIVATE_ROOT=

# --- Formal-study policy ----------------------------------------------------
# Path to the formal-study configuration, when not passed as an explicit
# argument. Research callers use research/configs/formal-study.json.
CUA_FORMAL_STUDY_CONFIG=
# Path to the operator's private human-research determination record (for
# example an ethics-board decision). Required only for human-data cells; keep
# the record itself under CUA_PRIVATE_ROOT.
CUA_HUMAN_RESEARCH_DETERMINATION_RECORD=

# --- Extension E2E harness (npm --prefix extension run e2e) -----------------
# Chrome/Chromium executable; defaults to Puppeteer's Chrome for Testing.
CUA_E2E_CHROME=
# Directory for the result bundle (its name must contain "e2e"); defaults to
# a directory under the OS temp dir. Validate it with
# python tools/ci/validate_e2e_bundle.py "$CUA_E2E_RESULT_DIR".
CUA_E2E_RESULT_DIR=
# Directory for the disposable browser profile; defaults to the OS temp dir.
CUA_E2E_RUNTIME_DIR=
# Comma-separated case IDs to run, e.g. T00,T03 (default: all cases).
CUA_E2E_CASES=
# 1 = launch Chrome without its sandbox. CI-only (Linux runners whose kernel
# blocks unprivileged user namespaces); never set it on a workstation.
CUA_E2E_CI_NO_SANDBOX=
# 1 = run Chrome in new headless mode where extensions are supported.
CUA_E2E_HEADLESS=
