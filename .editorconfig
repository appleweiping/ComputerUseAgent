# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100

[*.{md,markdown}]
# Two trailing spaces are a Markdown line break.
trim_trailing_whitespace = false

[{*.cmd,*.bat}]
end_of_line = crlf

[Makefile]
indent_style = tab

# Archived, hash-bound research bytes: never let an editor rewrite them.
[{research/evidence/**,research/literature/generated/**,research/fp_agent/notebooks/*.execution.json}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
