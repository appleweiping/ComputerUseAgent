{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/appleweiping/ComputerUseAgent/schemas/cui-source-manifest-v1.schema.json",
  "title": "CUI source manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "created_at_utc", "sources"],
  "properties": {
    "schema_version": {"const": "cui-source-manifest-v1"},
    "manifest_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "created_at_utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    }
  },
  "$defs": {
    "safeHttps": {
      "type": "string",
      "pattern": "^https://[^\\s?#]+$"
    },
    "repoPath": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "locator": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": {"const": "https_url"},
            "value": {"$ref": "#/$defs/safeHttps"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": {"const": "repository_path"},
            "value": {"$ref": "#/$defs/repoPath"}
          }
        }
      ]
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier", "redistribution"],
      "properties": {
        "identifier": {"type": "string", "minLength": 1, "maxLength": 160},
        "license_url": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/safeHttps"}
          ]
        },
        "redistribution": {
          "enum": ["allowed", "metadata_only", "restricted", "unknown"]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "title",
        "source_type",
        "access_class",
        "locator",
        "retrieved_at_utc",
        "sha256",
        "byte_count",
        "license"
      ],
      "properties": {
        "source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{2,159}$"},
        "title": {"type": "string", "minLength": 1, "maxLength": 500},
        "source_type": {
          "enum": [
            "api_response",
            "dataset",
            "paper",
            "repository_file",
            "software_release",
            "web_page"
          ]
        },
        "access_class": {
          "enum": [
            "first_party_public",
            "external_public",
            "external_restricted",
            "third_party_existing_data"
          ]
        },
        "locator": {"$ref": "#/$defs/locator"},
        "retrieved_at_utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "byte_count": {"type": "integer", "minimum": 0},
        "license": {"$ref": "#/$defs/license"}
      }
    }
  }
}
