{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/appleweiping/ComputerUseAgent/schemas/cui-detector-dataset-v2.schema.json",
  "title": "CUI detector dataset v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "records"],
  "properties": {
    "schema_version": {"const": "cui-detector-dataset-v2"},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/record"}
    },
    "audit": {"$ref": "#/$defs/audit"},
    "source_manifest": {"$ref": "#/$defs/manifestRef"},
    "provenance": {
      "$comment": "Explicit extension point for stage-specific immutable provenance; the Python validator recursively rejects secret-like keys, values, and absolute paths.",
      "type": "object",
      "propertyNames": {
        "not": {
          "pattern": "(?i)(api[_-]?key|access[_-]?token|secret|password|credential|authorization|cookie)"
        }
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "records": {
            "contains": {
              "type": "object",
              "required": ["evidence_class"],
              "properties": {"evidence_class": {"const": "external_restricted"}}
            }
          }
        }
      },
      "then": {"required": ["source_manifest"]}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repoPath": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "manifestRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "manifest_id", "repository_path", "sha256"],
      "properties": {
        "schema_version": {"const": "cui-source-manifest-v1"},
        "manifest_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
        "repository_path": {"$ref": "#/$defs/repoPath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "quality": {
      "$comment": "Explicit extractor-specific extension point; safety scanning remains mandatory.",
      "type": "object",
      "propertyNames": {
        "not": {
          "pattern": "(?i)(api[_-]?key|access[_-]?token|secret|password|credential|authorization|cookie)"
        }
      },
      "additionalProperties": true
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_count",
        "duration_ms",
        "event_rate_hz",
        "inter_event_median_ms",
        "inter_event_p90_ms",
        "inter_event_cv",
        "inter_event_burstiness",
        "time_to_first_input_ms",
        "pointer_path_px",
        "pointer_speed_px_s",
        "pointer_straightness",
        "pointer_turning_entropy",
        "click_dwell_median_ms",
        "pre_click_movement_median_px",
        "inter_key_median_ms",
        "key_hold_median_ms",
        "correction_ratio",
        "focus_transition_count",
        "event_type_entropy",
        "missing_pointer",
        "missing_keyboard",
        "missing_click_dwell",
        "missing_focus"
      ],
      "properties": {
        "event_count": {"type": "number", "minimum": 0},
        "duration_ms": {"type": "number", "minimum": 0},
        "event_rate_hz": {"type": "number", "minimum": 0},
        "inter_event_median_ms": {"type": "number", "minimum": 0},
        "inter_event_p90_ms": {"type": "number", "minimum": 0},
        "inter_event_cv": {"type": "number", "minimum": 0},
        "inter_event_burstiness": {"type": "number", "minimum": -1, "maximum": 1},
        "time_to_first_input_ms": {"type": "number", "minimum": 0},
        "pointer_path_px": {"type": "number", "minimum": 0},
        "pointer_speed_px_s": {"type": "number", "minimum": 0},
        "pointer_straightness": {"type": "number", "minimum": 0, "maximum": 1},
        "pointer_turning_entropy": {"type": "number", "minimum": 0, "maximum": 1},
        "click_dwell_median_ms": {"type": "number", "minimum": 0},
        "pre_click_movement_median_px": {"type": "number", "minimum": 0},
        "inter_key_median_ms": {"type": "number", "minimum": 0},
        "key_hold_median_ms": {"type": "number", "minimum": 0},
        "correction_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "focus_transition_count": {"type": "number", "minimum": 0},
        "event_type_entropy": {"type": "number", "minimum": 0, "maximum": 1},
        "missing_pointer": {"enum": [0, 1]},
        "missing_keyboard": {"enum": [0, 1]},
        "missing_click_dwell": {"enum": [0, 1]},
        "missing_focus": {"enum": [0, 1]}
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_ref",
        "source_sha256",
        "label",
        "task_group",
        "agent_family",
        "evidence_class",
        "participant_scope",
        "features",
        "quality"
      ],
      "properties": {
        "schema_version": {"const": "cui-detector-record-v2"},
        "record_ref": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "label": {"enum": ["agent", "human"]},
        "task_group": {"type": "string", "minLength": 1, "maxLength": 200},
        "agent_family": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1, "maxLength": 200}
          ]
        },
        "evidence_class": {
          "enum": [
            "synthetic_test_fixture",
            "formal_trace",
            "external_public",
            "external_restricted"
          ]
        },
        "participant_scope": {
          "enum": [
            "synthetic_no_participant",
            "single_self_participant",
            "approved_multi_participant",
            "public_dataset",
            "third_party_existing_data"
          ]
        },
        "features": {"$ref": "#/$defs/features"},
        "quality": {"$ref": "#/$defs/quality"}
      },
      "allOf": [
        {
          "if": {"properties": {"label": {"const": "human"}}},
          "then": {"properties": {"agent_family": {"type": "null"}}}
        },
        {
          "if": {"properties": {"evidence_class": {"const": "synthetic_test_fixture"}}},
          "then": {"properties": {"participant_scope": {"const": "synthetic_no_participant"}}}
        },
        {
          "if": {"properties": {"evidence_class": {"const": "external_public"}}},
          "then": {"properties": {"participant_scope": {"const": "public_dataset"}}}
        },
        {
          "if": {"properties": {"evidence_class": {"const": "external_restricted"}}},
          "then": {"properties": {"participant_scope": {"const": "third_party_existing_data"}}}
        },
        {
          "if": {"properties": {"evidence_class": {"const": "formal_trace"}}},
          "then": {
            "properties": {
              "participant_scope": {
                "enum": ["single_self_participant", "approved_multi_participant"]
              }
            }
          }
        }
      ]
    },
    "stringIntMap": {
      "$comment": "Explicit dynamic-key count map; values remain closed to non-negative integers.",
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_count",
        "task_count",
        "tasks",
        "class_counts",
        "task_counts",
        "evidence_classes",
        "participant_scopes",
        "dataset_sha256"
      ],
      "properties": {
        "record_count": {"type": "integer", "minimum": 1},
        "task_count": {"type": "integer", "minimum": 1},
        "tasks": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "class_counts": {"$ref": "#/$defs/stringIntMap"},
        "task_counts": {"$ref": "#/$defs/stringIntMap"},
        "evidence_classes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "participant_scopes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "dataset_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
